{
  "name": "computer-evolution-lab",
  "version": "2.0.0",
  "private": true,
  "description": "17 operational historical, modern, and frontier computers + 18-scene 4K HDR 3D interactive museum with live RV32IM + WebGL2 Modern Mini PC and orchestral WebAudio score.",
  "scripts": {
    "start": "node tools/serve.mjs",
    "dev": "node tools/serve.mjs",
    "test": "node tools/run-tests.mjs",
    "test:ci": "node tools/run-tests.mjs --ci-headless-optional",
    "audit:4k": "node tools/render-4k-audit.mjs",
    "build:icon": "node tools/build-icon.mjs",
    "build:exe": "node tools/build-desktop.mjs",
    "install:desktop": "node tools/build-desktop.mjs --install",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,md,yml}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
